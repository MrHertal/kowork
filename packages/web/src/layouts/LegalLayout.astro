---
import Footer from "../components/landing/Footer.astro";
import Header from "../components/landing/Header.astro";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  lastUpdated: string;
}

const { title, description, heading, lastUpdated } = Astro.props;
---

<Layout title={title} description={description}>
  <Header />
  <main class="mx-auto max-w-3xl px-5 py-16 sm:px-6 sm:py-20">
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{heading}</h1>
    <p class="mt-3 text-sm text-muted-foreground">
      Last updated: {lastUpdated}
    </p>
    <div
      class="mt-10 leading-7 text-muted-foreground [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-4 [&_a]:hover:opacity-75 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-foreground [&_h3]:mt-8 [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-foreground [&_p]:mt-4 [&_strong]:font-semibold [&_strong]:text-foreground [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"
    >
      <slot />
    </div>
  </main>
  <Footer />
</Layout>
