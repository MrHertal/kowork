{
  "name": "kowork",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @kowork/electron build",
    "build:sidecar": "pnpm --filter @kowork/electron build:sidecar",
    "dev": "pnpm --filter @kowork/electron dev",
    "format": "prettier . --write",
    "lint": "pnpm --filter @kowork/app lint",
    "lint:fix": "pnpm --filter @kowork/app lint:fix",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=24"
  }
}
