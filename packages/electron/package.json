{
  "name": "@kowork/electron",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "predev": "tsx ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "tsx ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "build:runtime": "tsx ./scripts/build-runtime.ts",
    "ensure:runtime": "tsx ./scripts/ensure-runtime.ts",
    "smoke:runtime": "tsx ./scripts/smoke-runtime.ts",
    "preview": "pnpm run ensure:runtime && electron-vite preview",
    "package": "pnpm run ensure:runtime && electron-builder --config electron-builder.config.ts",
    "package:mac": "pnpm run ensure:runtime && electron-builder --mac --config electron-builder.config.ts",
    "package:win": "pnpm run ensure:runtime && electron-builder --win --config electron-builder.config.ts",
    "package:linux": "pnpm run ensure:runtime && electron-builder --linux --config electron-builder.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-beta.19-d95b7a4",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.8",
    "electron-window-state": "^5.0.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@kowork/app": "workspace:*",
    "@lydell/node-pty": "1.2.0-beta.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.2.1",
    "electron-builder": "^26.14.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "4.23.10",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10"
  }
}
