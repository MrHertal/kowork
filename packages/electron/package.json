{
  "name": "@kowork/electron",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc -b",
    "predev": "tsx ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "tsx ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "build:runtime": "tsx ./scripts/build-runtime.ts",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-beta.19-d95b7a4",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.8",
    "electron-window-state": "^5.0.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@kowork/app": "workspace:*",
    "@lydell/node-pty": "1.2.0-beta.10",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "41.2.1",
    "electron-builder": "^26.14.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.22.4",
    "typescript": "~5.6.3",
    "vite": "^7.3.5"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10"
  }
}
