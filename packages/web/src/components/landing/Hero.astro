---
import productScreenshot from "../../assets/product-screenshot.png";
import { DownloadButton } from "../DownloadButton";
---

<section
  class="relative overflow-hidden px-5 pt-20 pb-20 sm:px-6 sm:pt-28 sm:pb-28"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-[38rem] max-w-5xl bg-[radial-gradient(circle_at_50%_20%,color-mix(in_oklab,var(--primary)_18%,transparent),transparent_68%)]"
  >
  </div>

  <div class="mx-auto max-w-6xl text-center">
    <div
      class="mx-auto mb-6 inline-block rounded-full border border-primary/20 bg-primary-muted px-3 py-1 text-sm font-medium text-primary"
    >
      The open-source alternative to Claude Cowork
    </div>
    <h1
      class="mx-auto max-w-4xl text-5xl font-semibold tracking-[-0.045em] text-balance sm:text-6xl lg:text-7xl"
    >
      Give the busywork to <span class="text-primary">Kowork.</span>
    </h1>
    <p
      class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-pretty text-muted-foreground sm:text-xl"
    >
      Describe the outcome in plain language. Kowork works directly in your
      folder and comes back with finished documents, spreadsheets,
      presentations, and more.
    </p>
    <div
      class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row"
    >
      <DownloadButton />
      <a
        href="https://github.com/MrHertal/kowork"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-border bg-card px-6 py-3 text-base font-semibold shadow-sm transition hover:-translate-y-0.5 hover:border-foreground/25"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="size-5 fill-current">
          <path
            d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.36-3.9-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.3-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.12 3.05.73.81 1.17 1.83 1.17 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.18c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
          ></path>
        </svg>
        View on GitHub
      </a>
    </div>

    <div class="relative mx-auto mt-16 max-w-5xl sm:mt-20">
      <div
        class="absolute inset-x-12 bottom-0 -z-10 h-1/2 rounded-full bg-primary/20 blur-3xl"
      >
      </div>
      <div
        class="overflow-hidden rounded-xl border border-border bg-card shadow-2xl shadow-foreground/10 sm:rounded-2xl"
      >
        <img
          src={productScreenshot.src}
          alt="Kowork completing an Excel sales report with formulas and a revenue chart"
          width={productScreenshot.width}
          height={productScreenshot.height}
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>
